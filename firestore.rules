rules_version = '2';

// Reglas de seguridad de Firestore para RoleArte.
// Cada usuario solo puede leer y escribir sus propios personajes, en users/{uid}/characters/*.
// Pegá este archivo completo en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/characters/{characterId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
